# ---------------------------------------------------------------------------
# Keypad — local development environment
#
# Generated: 2026-09-19
# This file is gitignored (see .gitignore) and is loaded by Next.js
# automatically. Restart the dev server after editing:  npm run dev
#
# Two ways to make Firebase Authentication work:
#
#   1) **Emulator (recommended for local dev, no Firebase project needed)**
#      Keep the emulator hosts below set and run:
#        npm run emulator   # in one terminal
#        npm run dev        # in another
#      The five NEXT_PUBLIC_FIREBASE_* values can be any non-empty string
#      when using the emulator — they are only validated when talking to
#      production Firebase. `demo-*` values are used here.
#
#   2) **Real Firebase project (for shared data / production)**
#      Comment out / delete the two emulator lines, then fill the
#      NEXT_PUBLIC_FIREBASE_* block and the FIREBASE_* service-account
#      block with real values from:
#        Firebase console → Project settings → Your apps → SDK setup and configuration
#        Project settings → Service accounts → Generate new private key
#      Also set DATA_PROVIDER=firestore and STORAGE_PROVIDER=firebase and run
#        npm run doctor   — it probes Firestore, Auth, and Storage and names
#        exactly what is still missing.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Keypad
NEXT_PUBLIC_ENABLE_TYPING_GAME=true

# --- Providers -------------------------------------------------------------
# memory = in-process store, wiped on restart; firestore/firebase = real Firebase
DATA_PROVIDER=memory
STORAGE_PROVIDER=memory

# --- Firebase client (public by design) ------------------------------------
# When using the emulator these can be any non-empty values. When using a real
# project copy them from the Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-emulator-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:demoappid1234567890abcdef

# --- Firebase Admin (server only — never NEXT_PUBLIC_) ---------------------
# Required for production Firebase. When using the Auth emulator locally these
# may stay blank — the Admin SDK will talk to the emulator instead.
# For production, paste the service-account key with newlines escaped as \n:
#   "-----BEGIN PRIVATE KEY-----\nMIIEvQ...==\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=demo-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-demo@demo-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=

# --- Firebase Auth emulator (local development only) -----------------------
# Leave both set to run without a real project. The emulator must be running:
#   npm run emulator
# Remove / blank both to use production Firebase (then fill the blocks above).
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Administrator ---------------------------------------------------------
# The uid of the administrator account. Set it after the first registration
# (`npm run seed` prints the uid). Leave blank until then — empty values count as unset.
ADMIN_UID=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- Secret code / access --------------------------------------------------
# Signs access sessions and challenge tokens. MUST be a long random string in
# production, e.g. `openssl rand -hex 32`. This value was generated for this
# local install — replace it with `openssl rand -hex 32` in production.
APP_SECRET=80a24afa4529123dc0e430c54c34767fc41679bc9710e7f1b6a9ae296e678db1
SECRET_CODE_MAX_LENGTH=15
SEED_SECRET_CODE=opensesame

# --- WebRTC ----------------------------------------------------------------
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Security headers / logging --------------------------------------------
CSP_MODE=enforce
ENABLE_SECURITY_HEADERS=true
LOG_LEVEL=info
