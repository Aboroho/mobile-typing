{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@mt/types": ["../../packages/types/src/index.ts"],
      "@mt/validation": ["../../packages/validation/src/index.ts"],
      "@mt/domain": ["../../packages/domain/src/index.ts"],
      "@mt/api-client": ["../../packages/api-client/src/index.ts"],
      "@mt/utils": ["../../packages/utils/src/index.ts"],
      "@mt/config": ["../../packages/config/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
