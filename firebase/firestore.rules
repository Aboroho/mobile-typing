rules_version = '2';

/**
 * Defence in depth.
 *
 * The application's own API layer performs every authorisation check with the
 * Admin SDK (which bypasses these rules), so a client talking to our API is
 * checked twice. These rules matter for anyone who points the Firebase *client*
 * SDK straight at the database — they must not be able to read somebody else's
 * conversation, and they must never be able to write.
 *
 * Administrator identity is the custom claim `role == 'admin'`, set by
 * `scripts/set-admin-claim.mjs` from the ADMIN_UID environment variable.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    // --- users -------------------------------------------------------------
    match /users/{userId} {
      // A user reads their own profile; administrators read any profile.
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      // Profiles are created and mutated exclusively by the Admin SDK.
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- conversations -----------------------------------------------------
    match /conversations/{conversationId} {
      allow get: if isParticipant(conversationId) || isAdmin();
      // Listing is done through the per-user index collection below.
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      // --- messages --------------------------------------------------------
      match /messages/{messageId} {
        // Participants read live; soft deleted rows stay readable by participants
        // because the *content* is removed server side (text is nulled out) and
        // only the placeholder is exposed. Deleted content in `metadata` is only
        // ever read through the admin API.
        allow get, list: if isParticipant(conversationId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // Per-user conversation index (fast list view).
    match /userConversations/{userId}/items/{conversationId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if isAdmin();
    }

    // --- media -------------------------------------------------------------
    match /media/{mediaId} {
      // Metadata only. Bytes live in Storage and are never served publicly.
      allow get: if signedIn()
        && (resource.data.ownerId == request.auth.uid
            || (resource.data.conversationId != null && isParticipant(resource.data.conversationId))
            || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- calls -------------------------------------------------------------
    match /calls/{callId} {
      allow get, list: if signedIn()
        && (resource.data.initiatorId == request.auth.uid
            || resource.data.recipientId == request.auth.uid
            || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // --- typing sessions (public game statistics) --------------------------
    match /typingSessions/{sessionId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // --- audit log: append-only, admin only --------------------------------
    match /adminAuditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // --- app configuration (secret code) -----------------------------------
    match /appConfig/{document} {
      // The secret code must never be readable through the client SDK; only the
      // server (Admin SDK) reads it, and it hands a challenge to the browser.
      allow read, write: if isAdmin();
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
