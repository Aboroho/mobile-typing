# ---------------------------------------------------------------------------
# Keypad — environment configuration
#
# Copy to `.env.local` for development. NEVER commit real values.
# Anything prefixed with NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore public by definition — no secret may ever use that prefix.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NODE_ENV=development
# development | test | staging | production
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Keypad
# true  = show the typing-practice game and require the secret code before
#         chat is reachable (the product's default disguise).
# false = skip the game and the secret-code gate entirely; visitors land
#         directly on sign-in, then chat. Read by both the browser and the
#         API (lib/auth/guard.ts), so it is safe to change without the two
#         sides disagreeing about whether an access session is required.
NEXT_PUBLIC_ENABLE_TYPING_GAME=true

# --- Providers -------------------------------------------------------------
# memory  = in-process store, local development and tests only
# firestore = Cloud Firestore through the Firebase Admin SDK (production)
DATA_PROVIDER=memory
# memory | firebase
STORAGE_PROVIDER=memory
# Authentication has no provider switch and no offline fallback: it is always
# Firebase Authentication (email/password). Use a live Firebase project or
# explicitly opt into the local Auth emulator (see docs/auth-testing.md).
# Old AUTH_PROVIDER / DEV_SESSION_SECRET settings are no longer used.

# --- Firebase client (public by design) ------------------------------------
# The browser uses these to sign users up and in. Without them nobody can
# authenticate, and the API answers every registration with UNAUTHENTICATED.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only — never NEXT_PUBLIC_) ---------------------
# From Project settings → Service accounts → Generate new private key.
# Escape newlines in the private key as \n when pasting into a dashboard field.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional local Auth emulator, host:port with NO http:// prefix. Never set in
# production. Both SDKs use it; browsers reach it through same-origin dev rewrites.
# For isolated tests, npm run e2e:auth supplies a demo project and needs no key.
FIREBASE_AUTH_EMULATOR_HOST=

# --- Administrator ---------------------------------------------------------
# The uid of the administrator account. Set it after the first registration
# (`npm run seed` prints the uid).
# Leave blank until then — empty optional values are treated as unset.
ADMIN_UID=
# Development convenience: an email is easier to know in advance than a uid.
# Ignored in favour of ADMIN_UID when both are set.
ADMIN_EMAIL=admin@example.com
# Password `npm run seed` registers the ADMIN_EMAIL account with. Development
# seeding only — the running server never reads it.
ADMIN_PASSWORD=ChangeMe123!

# --- Secret code / access --------------------------------------------------
# Signs access sessions and challenge tokens. MUST be a long random string in
# production, e.g. `openssl rand -hex 32`. (Authentication sessions are Firebase
# session cookies, which this secret does not sign.)
APP_SECRET=change-me-to-a-32-byte-random-hex
SECRET_CODE_MAX_LENGTH=15
# Bootstrap code used until an administrator sets one in /admin/settings.
SEED_SECRET_CODE=opensesame

# --- WebRTC ----------------------------------------------------------------
# Comma separated lists are allowed. STUN alone works on the same LAN; a TURN
# server is required for clients behind symmetric NATs (most mobile networks).
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Security headers / logging -------------------------------------------
# enforce | report | off
CSP_MODE=enforce
ENABLE_SECURITY_HEADERS=true
LOG_LEVEL=info
# Optional development tunnel/embedded preview allowlists. Leave blank normally.
# DEV_ALLOWED_ORIGINS accepts comma-separated hostnames (e.g. *.e2b.app).
# DEV_FRAME_ANCESTORS accepts space-separated parent origins (e.g. https://arena.ai).
# Production always denies framing, regardless of DEV_FRAME_ANCESTORS.
DEV_ALLOWED_ORIGINS=
DEV_FRAME_ANCESTORS=
