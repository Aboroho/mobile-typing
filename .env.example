# ---------------------------------------------------------------------------
# Keypad — environment configuration (PostgreSQL + S3 / local storage edition)
#
# Copy to `.env.local` for development. NEVER commit real values.
# Anything prefixed with NEXT_PUBLIC_ is inlined into the browser bundle and
# is therefore public by definition — no secret may use that prefix.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NODE_ENV=development
APP_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Keypad
NEXT_PUBLIC_WS_URL=ws://localhost:3000/api/v1/ws
NEXT_PUBLIC_ENABLE_TYPING_GAME=true

# --- Dev server origins (development only) ---------------------------------
# Extra hostnames the dev server may be reached from, comma separated. Local
# network addresses (192.168.*.*, 10.*.*.*, 172.*.*.*, 169.254.*.*) and mDNS
# names (**.local) are allowed by default so a phone on the same Wi-Fi can open
# `npm run dev`. Add a host here when the dev server is reached through a proxy
# or a public name; see next.config.ts.
# ALLOWED_DEV_ORIGINS=dev.example.com

# --- Providers -------------------------------------------------------------
# memory (dev/test only) | prisma (PostgreSQL, production)
DATA_PROVIDER=memory
# memory (dev/test only) | local (single-server VPS) | s3 (any S3-compatible service)
STORAGE_PROVIDER=memory

# --- PostgreSQL / Prisma ---------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mobile_typing?schema=public

# --- Session / auth --------------------------------------------------------
APP_SECRET=change-me-to-a-32-byte-random-hex-please-change-me
SESSION_COOKIE_NAME=mt_session
SESSION_DURATION_HOURS=336

# --- Administrator ---------------------------------------------------------
# The user id OR the email of the administrator account. ADMIN_UID takes
# precedence when both are set.
ADMIN_UID=
ADMIN_EMAIL=admin@example.com

# --- Secret code / access --------------------------------------------------
SECRET_CODE_MAX_LENGTH=15
SEED_SECRET_CODE=opensesame

# --- WebRTC ----------------------------------------------------------------
# Comma-separated lists are allowed. STUN works on most networks; TURN is
# required for clients behind symmetric NATs (most mobile networks).
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# --- Object storage --------------------------------------------------------
# Used when STORAGE_PROVIDER=s3 (AWS S3, MinIO, Cloudflare R2, …).
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=keypad-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
# Used when STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.local-storage
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_SIGN_URL_TTL_SECONDS=600

# --- Upload limits ---------------------------------------------------------
MAX_IMAGE_BYTES=10485760
MAX_VOICE_BYTES=10485760
MAX_MESSAGE_LENGTH=4000

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10

# --- Outbox worker ---------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100

# --- Security / logging ----------------------------------------------------
CSP_MODE=enforce
ENABLE_SECURITY_HEADERS=true
LOG_LEVEL=info
